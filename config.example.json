{
  "enabled": true,
  "enableGitignore": true,
  "ignoreNames": [".git", "node_modules", ".pnpm-store", "dist", "build", ".venv", "__pycache__", ".DS_Store"],
  "ignorePatterns": ["*.pyc", "*.log", "*.tmp"],
  "trackSizeCap": 5242880,
  "blobSizeCap": 1048576,
  "maxFiles": 100000,
  "maxTotalBlobBytes": 524288000
}
